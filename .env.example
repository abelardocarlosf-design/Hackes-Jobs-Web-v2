# ─── Plantilla de variables de entorno ────────────────────────────
# Ambos archivos están ignorados por git: NUNCA subas secretos al repositorio.
#
# REPARTO ENTRE LOS DOS ARCHIVOS (importa, y es un error fácil de cometer):
#   .env        → DATABASE_URL, DIRECT_URL, JWT_SECRET, NEXT_PUBLIC_GOOGLE_CLIENT_ID
#   .env.local  → todo lo demás (SMTP, n8n, webhooks, Stripe, IA)
#
# El CLI de Prisma lee `.env` y NO lee `.env.local`. Si DATABASE_URL está en los
# dos, las migraciones van a una base y la aplicación a otra, y el síntoma es
# "la tabla no existe" en runtime, no al migrar.
#
# IMPORTANTE: si un valor contiene `#`, enciérralo entre comillas dobles.
# Sin comillas, dotenv corta el valor en el primer `#` (lo trata como comentario).
#   Correcto:   SMTP_PASSWORD="mi#clave#rara"
#   Incorrecto: SMTP_PASSWORD=mi#clave#rara   → se lee solo "mi"

# ─── Base de datos: Neon PostgreSQL (va en .env) ──────────────────
# Provisionada desde el Marketplace de Vercel. En local se usa la rama `dev`
# de Neon, no SQLite ni un Postgres en Docker: la avería que se reparó fue
# justamente la divergencia entre desarrollo y producción.
#
# Conexión pooled (host con `-pooler`). Los parámetros no son opcionales: sin
# `pgbouncer=true`, Prisma emite PREPARE y PgBouncer los rechaza de forma
# intermitente bajo carga.
DATABASE_URL="postgresql://usuario:clave@host-pooler.region.aws.neon.tech/dbname?sslmode=require&pgbouncer=true&connection_limit=1"
# Conexión SIN pooler (el valor que Vercel inyecta como DATABASE_URL_UNPOOLED).
# La exige Prisma para migraciones. La integración de Neon no crea este nombre:
# hay que añadirlo a mano en Vercel.
DIRECT_URL="postgresql://usuario:clave@host.region.aws.neon.tech/dbname?sslmode=require"

# ─── Autenticación (va en .env) ───────────────────────────────────
# Secreto para firmar los JWT de sesión. Cadena larga y aleatoria:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# OBLIGATORIA: la aplicación no arranca sin ella, a propósito. Antes había un
# valor por defecto escrito en el código y publicado en este repositorio, con lo
# que cualquiera podía firmarse un token de administrador.
JWT_SECRET=

# Client ID de Google Identity Services. NO es secreto (viaja en el HTML), y la
# usan tanto el cliente como el servidor. Si se deja vacía, el botón de Google
# simplemente no se muestra y queda solo el acceso con email y contraseña.
# Recuerda: las NEXT_PUBLIC_* se inlinean en tiempo de build → hay que
# redesplegar para que un cambio en Vercel surta efecto.
# Authorized JavaScript origins en Google Cloud Console:
#   http://localhost:3000 · https://www.hackesjobs.com.mx · https://hackesjobs.com.mx
# Authorized redirect URIs: ninguna (GIS usa origins, no redirect).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# URL pública del sitio. La usa Stripe para success_url / cancel_url.
NEXT_PUBLIC_APP_URL=

# ─── Correo saliente (SMTP) ───────────────────────────────────────
# Requerido por: registro de candidatos (PDF de alta) y formulario de
# solicitud de talento. Sin esto, ambos flujos fallan.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
# Buzón interno que recibe las notificaciones. Si se omite, usa SMTP_USER.
NOTIFICATION_EMAIL=

# ─── n8n: webhooks y API de máquina ───────────────────────────────
# Clave que valida las llamadas entrantes a /api/n8n/*
N8N_API_KEY=
N8N_BASE_URL=
WEBHOOK_BASE_URL=
WEBHOOK_SECRET=

# Rutas de los workflows de psicometrías (WF-001 … WF-009)
WEBHOOK_LUSCHER=
WEBHOOK_DISC=
WEBHOOK_ALLPORT=
WEBHOOK_MOSS=
WEBHOOK_ZAVIC=
WEBHOOK_KOSTICK=
WEBHOOK_RAVEN=
WEBHOOK_TERMAN=
WEBHOOK_16PF=
WEBHOOK_MMPI=

# Sondeo de resultados de psicometrías
TEST_POLLING_INTERVAL_MS=
TEST_POLLING_TIMEOUT_MS=

# --- Almacenamiento de CVs ----------------------------------------
# Sin este token, los CVs se guardan en la carpeta local `storage/cv/`.
# Eso sirve en desarrollo, pero NO en produccion: el filesystem de Vercel es
# de solo lectura (salvo /tmp, que ademas es efimero). En produccion hay que
# provisionar Vercel Blob y definir este token, o las subidas se perderan.
BLOB_READ_WRITE_TOKEN=
# ─── Pagos (Stripe) ───────────────────────────────────────────────
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ─── IA ───────────────────────────────────────────────────────────
DEEPSEEK_API_KEY=

# ─── Semilla del primer administrador (opcional) ──────────────────
# Las lee `npx prisma db seed` para crear la cuenta admin inicial. Cambia la
# contraseña desde "Mi perfil" en cuanto entres.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# NOTA: BLOG_ADMIN_USER y BLOG_ADMIN_PASS ya no existen. El panel del blog usaba
# un segundo sistema de login (cookie hj_admin_token sobre data/users.json, con
# contraseñas en texto plano). Ahora todo pasa por la sesión única hj_token y el
# alta de personal se hace desde /admin/equipo.
