// Prisma Schema â€” Hacke's Jobs SaaS
// Local: SQLite | ProducciÃ³n: Supabase PostgreSQL
// Para migrar a Supabase: cambiar provider a "postgresql" y actualizar DATABASE_URL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// â”€â”€â”€ USERS â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         String    @default("candidate") // admin | recruiter | company | candidate
  avatar       String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Relations
  company   Company?
  candidate Candidate?

  @@map("users")
}

// â”€â”€â”€ COMPANIES â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
model Company {
  id        String   @id @default(cuid())
  name      String
  industry  String?
  size      String?
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())

  // FK
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Relations
  jobs         Job[]
  subscription Subscription?

  @@map("companies")
}

// â”€â”€â”€ JOBS (VACANTES) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
model Job {
  id           String   @id @default(cuid())
  title        String
  description  String
  salaryRange  String?
  location     String?
  modality     String?  // Presencial | HÃ­brido | Remoto
  status       String   @default("pending") // pending | approved | rejected | closed
  requirements String?  // JSON string: skills, experience, education
  schedule     String?  // JSON string: jornada laboral
  benefits     String?
  positions    Int      @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // FK
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // Relations
  applications Application[]

  @@map("jobs")
}

// â”€â”€â”€ CANDIDATES â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
model Candidate {
  id              String   @id @default(cuid())
  cvUrl           String?
  experienceYears Int      @default(0)
  skills          String?  // JSON string array
  education       String?
  phone           String?
  bio             String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // FK
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Relations
  applications Application[]
  testResults  TestResult[]
  testpurchases TestPurchase[]
  catSessions   CatSession[]

  @@map("candidates")
}

// â”€â”€â”€ APPLICATIONS â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
model Application {
  id        String   @id @default(cuid())
  status    String   @default("pending") // pending | reviewing | shortlisted | rejected | hired
  score     Int?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // FK
  jobId       String
  job         Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@unique([jobId, candidateId]) // Un candidato solo puede aplicar una vez por vacante
  @@map("applications")
}

// â”€â”€â”€ PSYCHOMETRIC TESTS â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
model PsychometricTest {
  id        String   @id @default(cuid())
  name      String
  type      String   // DISC | cognitive | personality | custom
  level     String   @default("basico") // basico | intermedio | avanzado | premium
  price     Float    @default(0.0) // 0 si es gratuito
  isPremium Boolean  @default(false)
  structure String   // JSON: preguntas, opciones, scoring rules
  duration  Int?     // minutos
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  // Relations
  results   TestResult[]
  purchases TestPurchase[]
  catItems    CatItem[]
  catSessions CatSession[]

  @@map("psychometric_tests")
}

// â”€â”€â”€ TEST RESULTS â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
model TestResult {
  id        String   @id @default(cuid())
  results   String   // JSON: respuestas del candidato
  score     Int?
  summary   String?  // Resumen generado
  createdAt DateTime @default(now())

  // FK
  candidateId String
  candidate   Candidate        @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  testId      String
  test        PsychometricTest @relation(fields: [testId], references: [id], onDelete: Cascade)

  @@map("test_results")
}

// â”€â”€â”€ TEST PURCHASES (STRIPE) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
model TestPurchase {
  id              String   @id @default(cuid())
  stripeSessionId String?  @unique
  amount          Float
  status          String   @default("pending") // pending | completed
  createdAt       DateTime @default(now())

  // FK
  candidateId String
  candidate   Candidate        @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  testId      String
  test        PsychometricTest @relation(fields: [testId], references: [id], onDelete: Cascade)

  @@unique([candidateId, testId]) // Un candidato solo compra un test una vez
  @@map("test_purchases")
}

// â”€â”€â”€ SUBSCRIPTIONS â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
model Subscription {
  id        String   @id @default(cuid())
  plan      String   @default("basic") // basic | pro | enterprise
  status    String   @default("active") // active | cancelled | expired
  startDate DateTime @default(now())
  endDate   DateTime?
  createdAt DateTime @default(now())

  // FK
  companyId String  @unique
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

// --- CAT (COMPUTERIZED ADAPTIVE TESTING) --------------
model CatItem {
  id              String   @id @default(cuid())
  testId          String
  test            PsychometricTest @relation(fields: [testId], references: [id], onDelete: Cascade)
  questionText    String
  options         String   // JSON string: [{"id": "a", "text": "Opción A"}, ...]
  correctOptionId String
  parameterA      Float    // Discriminación
  parameterB      Float    // Dificultad
  parameterC      Float    // Pseudo-adivinación
  active          Boolean  @default(true)
  
  @@map("cat_items")
}

model CatSession {
  id              String   @id @default(cuid())
  candidateId     String
  candidate       Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  testId          String
  test            PsychometricTest @relation(fields: [testId], references: [id], onDelete: Cascade)
  currentTheta    Float    @default(0.0)
  standardError   Float    @default(1.0)
  itemsAnswered   Int      @default(0)
  responses       String   @default("[]") // JSON: [{"itemId": "1", "isCorrect": true, "thetaBefore": 0.0}]
  status          String   @default("in_progress") // in_progress | completed
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@map("cat_sessions")
}