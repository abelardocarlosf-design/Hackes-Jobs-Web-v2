// Prisma Schema - Hacke's Jobs SaaS
// Base de datos: PostgreSQL (Neon, provisionado desde el Marketplace de Vercel).
// DATABASE_URL = conexion pooled (-pooler) | DIRECT_URL = sin pooler, para migraciones.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Pooled (host con `-pooler`): lo usa la app en runtime.
  url       = env("DATABASE_URL")
  // Sin pooler: lo exige Prisma para migraciones y introspección.
  directUrl = env("DIRECT_URL")
}

// --- USERS -------------------------------------------------------
model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  // Nullable a propósito: las cuentas creadas con Google no tienen contraseña.
  // `authProvider` distingue el caso para dar mensajes claros en /api/auth/login
  // y /api/auth/password en vez de un "credenciales inválidas" desconcertante.
  passwordHash String?
  authProvider String    @default("local") // local | google
  role         String    @default("candidate") // admin | recruiter | company | candidate
  avatar       String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Relations
  company   Company?
  candidate Candidate?
  cliente   Cliente?

  @@map("users")
}

// --- COMPANIES ---------------------------------------------------
model Company {
  id        String   @id @default(cuid())
  name      String
  industry  String?
  size      String?
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())

  // FK
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Relations
  subscription Subscription?

  @@map("companies")
}

// ─── VACANTES ──────────────────────────────────────────────────
// Las vacantes públicas ahora viven en `src/data/vacantes.ts` (file-based).
// El modelo `Job` y `Application` fueron retirados de Prisma en favor de un
// catálogo estático versionado en git, optimizado para SEO + Google Jobs.

// --- CANDIDATES --------------------------------------------------
model Candidate {
  id              String   @id @default(cuid())
  cvUrl           String?
  experienceYears Int      @default(0)
  skills          String?  // JSON string array
  education       String?
  phone           String?
  bio             String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // FK
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Relations
  testResults  TestResult[]
  testpurchases TestPurchase[]
  catSessions   CatSession[]

  @@map("candidates")
}

// --- PSYCHOMETRIC TESTS ------------------------------------------
model PsychometricTest {
  id        String   @id @default(cuid())
  // @unique para que los seeds puedan usar upsert. Sin esto, correr
  // prisma/seed-tests.ts dos veces duplica el catálogo entero.
  name      String   @unique
  type      String   // DISC | cognitive | personality | custom
  level     String   @default("basico") // basico | intermedio | avanzado | premium
  price     Float    @default(0.0) // 0 si es gratuito
  isPremium Boolean  @default(false)
  structure String   // JSON: preguntas, opciones, scoring rules
  duration  Int?     // minutos
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  // Relations
  results   TestResult[]
  purchases TestPurchase[]
  catItems    CatItem[]
  catSessions CatSession[]

  @@map("psychometric_tests")
}

// --- TEST RESULTS ------------------------------------------------
model TestResult {
  id        String   @id @default(cuid())
  results   String   // JSON: respuestas del candidato
  score     Int?
  summary   String?  // Resumen generado
  status    String   @default("completado") // pendiente | procesando | completado | fallido
  createdAt DateTime @default(now())

  // FK
  candidateId String
  candidate   Candidate        @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  testId      String
  test        PsychometricTest @relation(fields: [testId], references: [id], onDelete: Cascade)

  procesos Proceso[]

  @@map("test_results")
}

// --- TEST PURCHASES (STRIPE) -------------------------------------
model TestPurchase {
  id              String   @id @default(cuid())
  stripeSessionId String?  @unique
  amount          Float
  status          String   @default("pending") // pending | completed
  createdAt       DateTime @default(now())

  // FK
  candidateId String
  candidate   Candidate        @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  testId      String
  test        PsychometricTest @relation(fields: [testId], references: [id], onDelete: Cascade)

  @@unique([candidateId, testId]) // Un candidato solo compra un test una vez
  @@map("test_purchases")
}

// --- SUBSCRIPTIONS -----------------------------------------------
model Subscription {
  id        String   @id @default(cuid())
  plan      String   @default("basic") // basic | pro | enterprise
  status    String   @default("active") // active | cancelled | expired
  startDate DateTime @default(now())
  endDate   DateTime?
  createdAt DateTime @default(now())

  // FK
  companyId String  @unique
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

// ─── CRM INTERNO: CLIENTES, REQUISICIONES, PIPELINE ───────────
// Separado de User/Company/Candidate porque estos modelos representan
// registros de agencia (sin login necesariamente), no cuentas del SaaS.
model Cliente {
  id             String   @id @default(cuid())
  razonSocial    String
  rfc            String?
  contactoNombre String?
  contactoEmail  String?
  contactoTel    String?
  zona           String?
  tier           Int      @default(2) // 1 | 2
  createdAt      DateTime @default(now())

  // Vínculo opcional con una cuenta del SaaS. Nullable porque la mayoría de los
  // clientes son registros de agencia sin login; cuando existe, es lo que permite
  // a /mi-empresa listar "mis requisiciones" sin exponer las de otros clientes.
  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  requisiciones Requisicion[]

  @@map("clientes")
}

model Requisicion {
  id                String   @id @default(cuid())
  puesto            String
  zona              String?
  turno             String?
  bandaSalarialMin  Float?
  bandaSalarialMax  Float?
  estatus           String   @default("abierta") // abierta | en_proceso | terna_entregada | cerrada | cancelada
  fechaSolicitud    DateTime @default(now())
  fechaLimite       DateTime?
  createdAt         DateTime @default(now())

  // FK
  clienteId String
  cliente   Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  procesos Proceso[]

  @@map("requisiciones")
}

model Candidato {
  id                     String   @id @default(cuid())
  nombre                 String
  email                  String?
  telefono               String?
  zona                   String?
  puestoInteres          String?
  fuente                 String? // whatsapp | scraping | formulario | referido | otro
  consentimientoLFPDPPP  Boolean  @default(false)
  createdAt              DateTime @default(now())

  // CV. `cvKey` es una referencia opaca al almacenamiento (ruta local en
  // desarrollo, URL de Vercel Blob privado en producción). Nunca se expone al
  // cliente: el archivo se sirve por /api/candidatos/[id]/cv, que exige sesión
  // de reclutador o admin. Es dato personal bajo LFPDPPP.
  cvKey            String?
  cvNombreArchivo  String?
  cvSubidoEn       DateTime?

  // Datos que el reclutador completa a mano sobre la ficha.
  linkedin         String?
  experienciaAnios Int?
  notas            String?

  procesos     Proceso[]
  seguimientos Seguimiento[]

  @@map("candidatos")
}

model Proceso {
  id           String   @id @default(cuid())
  etapa        String   @default("atraccion") // atraccion | filtro_cv | psicometria | entrevista | terna | contratado | descartado
  scoreMatch   Float?
  notas        String?
  updatedAt    DateTime @updatedAt
  createdAt    DateTime @default(now())

  // FK
  requisicionId String
  requisicion   Requisicion @relation(fields: [requisicionId], references: [id], onDelete: Cascade)
  candidatoId   String
  candidato     Candidato   @relation(fields: [candidatoId], references: [id], onDelete: Cascade)

  // Enlace opcional a psicometría ya corrida en la infraestructura existente
  // (solo aplica si el candidato del pipeline también tiene cuenta Candidate/User)
  testResultId String?
  testResult   TestResult? @relation(fields: [testResultId], references: [id], onDelete: SetNull)

  // Resultado de psicometría reportado por n8n para candidatos de pipeline
  // sin cuenta de plataforma (no se puede usar TestResult porque exige un Candidate).
  psicometriaTipo          String?
  psicometriaResultadoJson String?
  psicometriaScoreGlobal   Float?
  psicometriaPdfUrl        String?

  seguimientos Seguimiento[]

  @@map("procesos")
}

// Seguimientos del reclutador sobre un candidato: la tarea pendiente concreta
// ("llamar el jueves", "enviar psicometría"). `automatico` marca los que crea
// el sistema al mover una etapa, para distinguirlos de los que agenda una persona.
model Seguimiento {
  id           String    @id @default(cuid())
  tipo         String    @default("llamada") // llamada | whatsapp | correo | psicometria | documentos | entrevista | otro
  nota         String?
  fechaLimite  DateTime
  completado   Boolean   @default(false)
  completadoEn DateTime?
  automatico   Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  candidatoId String
  candidato   Candidato @relation(fields: [candidatoId], references: [id], onDelete: Cascade)

  // Opcional: un seguimiento puede colgar de un proceso concreto o del candidato a secas.
  procesoId String?
  proceso   Proceso? @relation(fields: [procesoId], references: [id], onDelete: SetNull)

  @@index([completado, fechaLimite])
  @@map("seguimientos")
}

// --- CAT (COMPUTERIZED ADAPTIVE TESTING) -------------------------
model CatItem {
  id              String   @id @default(cuid())
  testId          String
  test            PsychometricTest @relation(fields: [testId], references: [id], onDelete: Cascade)
  questionText    String
  options         String   // JSON string: [{"id": "a", "text": "Opción A"}, ...]
  correctOptionId String
  parameterA      Float    // Discriminación
  parameterB      Float    // Dificultad
  parameterC      Float    // Pseudo-adivinación
  active          Boolean  @default(true)
  
  @@map("cat_items")
}

model CatSession {
  id              String   @id @default(cuid())
  candidateId     String
  candidate       Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  testId          String
  test            PsychometricTest @relation(fields: [testId], references: [id], onDelete: Cascade)
  currentTheta    Float    @default(0.0)
  standardError   Float    @default(1.0)
  itemsAnswered   Int      @default(0)
  responses       String   @default("[]") // JSON: [{"itemId": "1", "isCorrect": true, "thetaBefore": 0.0}]
  status          String   @default("in_progress") // in_progress | completed
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("cat_sessions")
}

// --- CONTENIDO (BLOG Y NEWSLETTER) -------------------------------
// Antes vivían en `data/blog/*.json` y `data/subscribers.json`, escritos con
// `fs`. En Vercel el disco es de solo lectura: el CMS no guardaba nada y cada
// suscripción se perdía en silencio. En local sí escribía, y por eso no se
// detectó antes.
model BlogPost {
  // El slug es la clave: toda la app busca y guarda por slug, nunca por id.
  slug       String   @id
  title      String
  content    String
  excerpt    String
  coverImage String
  author     String
  date       DateTime // Fecha de publicación que muestra el artículo.
  tags       String[] // Nativo de Postgres; no hace falta serializar a JSON.
  published  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // El listado público filtra por `published` y ordena por `date` descendente.
  @@index([published, date])
  @@map("blog_posts")
}

model Subscriber {
  id    String   @id @default(cuid())
  email String   @unique // La unicidad la impone la base, no una lectura previa.
  date  DateTime @default(now())

  @@map("subscribers")
}