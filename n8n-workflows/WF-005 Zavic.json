ight: 700; color: #2E7D32;\">✓ Principales Fortalezas</p>\n                <p style=\"margin: 0; font-size: 13px; color: #444444; line-height: 1.5;\">{{ $('Parsear JSON Seguro').item.json.Fortalezas }}</p>\n            </div>\n            <div style=\"flex: 1; background-color: #FFF4F4; padding: 15px; border-radius: 6px; border: 1px solid #FFD1D1;\">\n                <p style=\"margin: 0 0 10px 0; font-size: 14px; font-weight: 700; color: #C62828;\">⚠ Áreas de Riesgo / Monitoreo</p>\n                <p style=\"margin: 0; font-size: 13px; color: #444444; line-height: 1.5;\">{{ $('Parsear JSON Seguro').item.json.Areas_Oportunidad }}</p>\n            </div>\n        </div>\n        \n        <div style=\"text-align: center; margin-top: 30px; padding: 20px; background-color: #FAFAFA; border-radius: 8px;\">\n            <p style=\"margin: 0; font-size: 14px; color: #666666; text-transform: uppercase; font-weight: 700;\">Índice de Confiabilidad Organizacional</p>\n            <p style=\"margin: 5px 0 0 0; font-size: 28px; font-weight: 800; color: #000000;\">{{ $('Parsear JSON Seguro').item.json.Indice_Confiabilidad }}%</p>\n        </div>\n\n    </div>\n    \n    \n    <div style=\"background-color: #000000; padding: 20px; text-align: center;\">\n        <p style=\"color: #FFFFFF; font-size: 12px; margin: 0; letter-spacing: 2px; font-weight: 600;\">HACKES JOBS TECHNOLOGIES</p>\n        <p style=\"color: #666666; font-size: 11px; margin: 5px 0 0 0;\">AI Recruitment & Assessment Core</p>\n    </div>\n</div>",
