      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// 1. Extracción profunda y específica para Gemini 3.1 Flash Lite\nlet rawData = $input.item.json;\nlet textToParse = \"\";\n\n// Buscamos la ruta exacta donde Gemini 3.1 esconde el texto\nif (rawData.content && rawData.content.parts && rawData.content.parts[0] && rawData.content.parts[0].text) {\n    textToParse = rawData.content.parts[0].text;\n} else if (rawData.message && rawData.message.content) {\n    textToParse = rawData.message.content;\n} else if (rawData.text) {\n    textToParse = rawData.text;\n} else {\n    textToParse = JSON.stringify(rawData);\n}\n\n// 2. Forzar conversión a String\ntextToParse = String(textToParse);\n\n// 3. Extracción Blindada con Regex\nconst match = textToParse.match(/\\{[\\s\\S]*\\}/);\nlet extractedJson = match ? match[0] : textToParse;\n\n// 4. Parseo y salida\ntry {\n    const parsedData = JSON.parse(extractedJson);\n    return { json: parsedData };\n} catch (error) {\n    return {\n        json: {\n            \"Moral\": \"Error de Parseo\",\n            \"Legalidad\": \"Error de Parseo\",\n            \"Indiferencia\": \"Error de Parseo\",\n            \"Corrupto\": \"Error de Parseo\",\n            \"Economico\": \"Error de Parseo\",\n            \"Politico\": \"Error de Parseo\",\n            \"Social\": \"Error de Parseo\",\n            \"Religioso\": \"Error de Parseo\",\n            \"Tendencia_Valores\": \"Error de Parseo\",\n            \"Tendencia_Intereses\": \"Error de Parseo\"\n        }\n    };\n}"
      },
