        "mode": "runOnceForEachItem",
        "jsCode": "// 1. Extracción profunda y específica para Gemini 3.1 Flash Lite\nlet rawData = $input.item.json;\nlet textToParse = \"\";\n\nif (rawData.content && rawData.content.parts && rawData.content.parts[0] && rawData.content.parts[0].text) {\n    textToParse = rawData.content.parts[0].text;\n} else if (rawData.message && rawData.message.content) {\n    textToParse = rawData.message.content;\n} else if (rawData.text) {\n    textToParse = rawData.text;\n} else {\n    textToParse = JSON.stringify(rawData);\n}\n\ntextToParse = String(textToParse);\nconst match = textToParse.match(/\\{[\\s\\S]*\\}/);\nlet extractedJson = match ? match[0] : textToParse;\n\ntry {\n    const parsedData = JSON.parse(extractedJson);\n    return { json: parsedData };\n} catch (error) {\n    return {\n        json: {\n            \"A_Afabilidad\": \"Error\", \"B_Razonamiento\": \"Error\", \"C_Estabilidad\": \"Error\", \"E_Dominancia\": \"Error\",\n            \"F_Animacion\": \"Error\", \"G_Atencion_Normas\": \"Error\", \"H_Atrevimiento\": \"Error\", \"I_Sensibilidad\": \"Error\",\n            \"L_Vigilancia\": \"Error\", \"M_Abstraccion\": \"Error\", \"N_Privacidad\": \"Error\", \"O_Aprension\": \"Error\",\n            \"Q1_Apertura_Cambio\": \"Error\", \"Q2_Autosuficiencia\": \"Error\", \"Q3_Perfeccionismo\": \"Error\", \"Q4_Tension\": \"Error\",\n            \"Ext_Extraversion\": \"Error\", \"Ans_Ansiedad\": \"Error\", \"Ten_Tenacidad\": \"Error\", \"Ind_Independencia\": \"Error\",\n            \"Con_Autocontrol\": \"Error\", \"IM_Manipulacion_Imagen\": \"Error\", \"Perfil_Resumen\": \"Error de Parseo\", \"Adecuacion_Puesto\": \"Error\"\n        }\n    };\n}"
      },
