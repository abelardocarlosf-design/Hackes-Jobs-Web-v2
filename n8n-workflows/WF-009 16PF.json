    {
      "parameters": {
        "sendTo": "abelardo.carlos@hackesjobs.com.mx",
        "subject": "=Alerta Hackes Jobs Technologies: Nuevo Reporte 16PF Procesado [ {{ $('Webhook Recepción').item.json.body.datos_paciente.nombre_completo }} | {{ $('Webhook Recepción').item.json.body.datos_paciente.email }} ]",
