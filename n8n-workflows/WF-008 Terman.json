        "sendTo": "abelardo.carlos@hackesjobs.com.mx",
        "subject": "=Alerta Hackes Jobs Technologies: Nuevo Reporte Terman Procesado [ {{ $('Webhook Recepción').item.json.body.datos_paciente.nombre_completo }} | {{ $('Webhook Recepción').item.json.body.datos_paciente.email }} ]",
        "message": "=<div style=\"font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; max-width: 750px; margin: 0 auto; border: 1px solid #E0E0E0; border-radius: 8px; overflow: hidden; box-shadow: 0 4px 15px rgba(0,0,0,0.08);\">\n    <div style=\"background-color: #FF8C00; padding: 30px 20px; text-align: center; border-bottom: 4px solid #CC7000;\">\n        <h2 style=\"color: #FFFFFF; margin: 0; font-size: 26px; font-weight: 700; letter-spacing: 1px;\">Reporte Ejecutivo Terman-Merrill</h2>\n        <p style=\"color: #FFF3E0; margin: 8px 0 0 0; font-size: 15px; font-weight: 500;\">Evaluación de Inteligencia, Aprendizaje y Resolución de Problemas</p>\n    </div>\n    <div style=\"background-color: #FFFFFF; padding: 40px; color: #333333;\">\n        <p style=\"font-size: 16px; line-height: 1.6; margin-top: 0;\">Hola,</p>\n        <p style=\"font-size: 16px; line-height: 1.6;\">La IA ha completado el análisis profundo de la prueba cognitiva Terman. El candidato ha recibido el enlace de pago correspondiente para liberar el proceso técnico.</p>\n\n        <div style=\"background-color: #F8F9FA; border-left: 5px solid #000000; padding: 20px; margin: 30px 0; border-radius: 0 4px 4px 0;\">\n            <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\">\n                <tr>\n                    <td width=\"50%\" style=\"padding-bottom: 15px;\">\n                        <p style=\"margin: 0; font-size: 12px; color: #888888; text-transform: uppercase; font-weight: 700; letter-spacing: 1px;\">Candidato Evaluado</p>\n                        <p style=\"margin: 5px 0 0 0; font-size: 18px; font-weight: 700; color: #000000;\">{{ $('Webhook Recepción').item.json.body.datos_paciente.nombre_completo }}</p>\n                    </td>\n                    <td width=\"50%\" style=\"padding-bottom: 15px;\">\n                        <p style=\"margin: 0; font-size: 12px; color: #888888; text-transform: uppercase; font-weight: 700; letter-spacing: 1px;\">Correo Electrónico</p>\n                        <p style=\"margin: 5px 0 0 0; font-size: 16px; font-weight: 600; color: #FF8C00;\">{{ $('Webhook Recepción').item.json.body.datos_paciente.email }}</p>\n                    </td>\n                </tr>\n            </table>\n        </div>\n\n        <div style=\"display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin-bottom: 30px;\">\n            <div style=\"background-color: #FFF8F0; padding: 15px; text-align: center; border-radius: 6px; border: 1px solid #FFDAB9;\">\n                <p style=\"margin: 0; font-size: 11px; text-transform: uppercase; font-weight: 700; color: #666666;\">CI Estimado</p>\n                <p style=\"margin: 5px 0 0 0; font-size: 24px; font-weight: 800; color: #FF8C00;\">{{ $('Parsear JSON Seguro').item.json.CI_Total }}</p>\n            </div>\n            <div style=\"background-color: #FFF8F0; padding: 15px; text-align: center; border-radius: 6px; border: 1px solid #FFDAB9;\">\n                <p style=\"margin: 0; font-size: 11px; text-transform: uppercase; font-weight: 700; color: #666666;\">Percentil</p>\n                <p style=\"margin: 5px 0 0 0; font-size: 24px; font-weight: 800; color: #FF8C00;\">{{ $('Parsear JSON Seguro').item.json.Percentil }}</p>\n            </div>\n            <div style=\"background-color: #FFF8F0; padding: 15px; text-align: center; border-radius: 6px; border: 1px solid #FFDAB9;\">\n                <p style=\"margin: 0; font-size: 11px; text-transform: uppercase; font-weight: 700; color: #666666;\">Rango</p>\n                <p style=\"margin: 5px 0 0 0; font-size: 24px; font-weight: 800; color: #FF8C00;\">{{ $('Parsear JSON Seguro').item.json.Rango }}</p>\n            </div>\n        </div>\n\n        <h3 style=\"color: #000000; border-bottom: 2px solid #EEEEEE; padding-bottom: 10px; margin-top: 40px; font-size: 20px;\">Análisis de las 10 Series Cognitivas</h3>\n        \n        <div style=\"display: grid; grid-template-columns: 1fr 1fr; gap: 15px; margin-bottom: 25px;\">\n            \n            <div style=\"background-color: #F8F9FA; padding: 12px; border-radius: 6px; border-left: 3px solid #333333;\">\n                <p style=\"margin: 0 0 5px 0; font-size: 13px; font-weight: 700; color: #000000;\">I. Información (Cultura General)</p>\n                <p style=\"margin: 0; font-size: 12px; color: #444444; line-height: 1.5;\">{{ $('Parsear JSON Seguro').item.json.S1_Informacion }}</p>\n            </div>\n            \n            <div style=\"background-color: #F8F9FA; padding: 12px; border-radius: 6px; border-left: 3px solid #333333;\">\n                <p style=\"margin: 0 0 5px 0; font-size: 13px; font-weight: 700; color: #000000;\">II. Juicio (Sentido Común)</p>\n                <p style=\"margin: 0; font-size: 12px; color: #444444; line-height: 1.5;\">{{ $('Parsear JSON Seguro').item.json.S2_Juicio }}</p>\n            </div>\n            \n            <div style=\"background-color: #F8F9FA; padding: 12px; border-radius: 6px; border-left: 3px solid #333333;\">\n                <p style=\"margin: 0 0 5px 0; font-size: 13px; font-weight: 700; color: #000000;\">III. Vocabulario</p>\n                <p style=\"margin: 0; font-size: 12px; color: #444444; line-height: 1.5;\">{{ $('Parsear JSON Seguro').item.json.S3_Vocabulario }}</p>\n            </div>\n            \n            <div style=\"background-color: #F8F9FA; padding: 12px; border-radius: 6px; border-left: 3px solid #333333;\">\n                <p style=\"margin: 0 0 5px 0; font-size: 13px; font-weight: 700; color: #000000;\">IV. Síntesis</p>\n                <p style=\"margin: 0; font-size: 12px; color: #444444; line-height: 1.5;\">{{ $('Parsear JSON Seguro').item.json.S4_Sintesis }}</p>\n            </div>\n            \n            <div style=\"background-color: #F8F9FA; padding: 12px; border-radius: 6px; border-left: 3px solid #333333;\">\n                <p style=\"margin: 0 0 5px 0; font-size: 13px; font-weight: 700; color: #000000;\">