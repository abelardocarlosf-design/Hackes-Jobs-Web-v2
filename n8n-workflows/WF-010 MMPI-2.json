      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// 1. Extracción profunda y específica para Gemini 3.1 Flash Lite\nlet rawData = $input.item.json;\nlet textToParse = \"\";\n\nif (rawData.content && rawData.content.parts && rawData.content.parts[0] && rawData.content.parts[0].text) {\n    textToParse = rawData.content.parts[0].text;\n} else if (rawData.message && rawData.message.content) {\n    textToParse = rawData.message.content;\n} else if (rawData.text) {\n    textToParse = rawData.text;\n} else {\n    textToParse = JSON.stringify(rawData);\n}\n\ntextToParse = String(textToParse);\nconst match = textToParse.match(/\\{[\\s\\S]*\\}/);\nlet extractedJson = match ? match[0] : textToParse;\n\ntry {\n    const parsedData = JSON.parse(extractedJson);\n    return { json: parsedData };\n} catch (error) {\n    return {\n        json: {\n            \"L_Mentira\": \"Error\", \"F_Incoherencia\": \"Error\", \"K_Correccion\": \"Error\", \n            \"1_Hs\": \"Error\", \"2_D\": \"Error\", \"3_Hy\": \"Error\", \"4_Pd\": \"Error\", \n            \"5_Mf\": \"Error\", \"6_Pa\": \"Error\", \"7_Pt\": \"Error\", \"8_Sc\": \"Error\", \n            \"9_Ma\": \"Error\", \"0_Si\": \"Error\", \"Validez_Perfil\": \"Error\", \n            \"Interpretacion_Breve\": \"Error de Parseo\", \"Alerta_Riesgo\": \"Error\"\n        }\n    };\n}"
      },
