    {
      "parameters": {
        "sendTo": "abelardo.carlos@hackesjobs.com.mx",
        "subject": "=Alerta Hackes Jobs Technologies: Nuevo Reporte MMPI-2 Procesado [ {{ $('Webhook Recepción').item.json.body.datos_paciente.nombre_completo }} | {{ $('Webhook Recepción').item.json.body.datos_paciente.email }} ]",
        "message": "=<div style=\"font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; max-width: 800px; margin: 0 auto; border: 1px solid #E0E0E0; border-radius: 8px; overflow: hidden; box-shadow: 0 4px 15px rgba(0,0,0,0.08);\">\n    <div style=\"background-color: #D32F2F; padding: 30px 20px; text-align: center; border-bottom: 4px solid #B71C1C;\">\n        <h2 style=\"color: #FFFFFF; margin: 0; font-size: 26px; font-weight: 700; letter-spacing: 1px;\">Reporte Clínico Ejecutivo MMPI-2</h2>\n        <p style=\"color: #FFEBEE; margin: 8px 0 0 0; font-size: 15px; font-weight: 500;\">Inventario Multifásico de Personalidad de Minnesota</p>\n    </div>\n    <div style=\"background-color: #FFFFFF; padding: 40px; color: #333333;\">\n        <p style=\"font-size: 16px; line-height: 1.6; margin-top: 0;\">Hola,</p>\n        <p style=\"font-size: 16px; line-height: 1.6;\">La IA ha completado el análisis clínico profundo de la prueba MMPI-2. El candidato ha recibido el enlace de pago correspondiente para liberar el proceso técnico.</p>\n\n        <div style=\"background-color: #F8F9FA; border-left: 5px solid #000000; padding: 20px; margin: 30px 0; border-radius: 0 4px 4px 0;\">\n            <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\">\n                <tr>\n                    <td width=\"50%\" style=\"padding-bottom: 15px;\">\n                        <p style=\"margin: 0; font-size: 12px; color: #888888; text-transform: uppercase; font-weight: 700; letter-spacing: 1px;\">Candidato Evaluado</p>\n                        <p style=\"margin: 5px 0 0 0; font-size: 18px; font-weight: 700; color: #000000;\">{{ $('Webhook Recepción').item.json.body.name }}</p>\n                    </td>\n                    <td width=\"50%\" style=\"padding-bottom: 15px;\">\n                        <p style=\"margin: 0; font-size: 12px; color: #888888; text-transform: uppercase; font-weight: 700; letter-spacing: 1px;\">Correo Electrónico</p>\n                        <p style=\"margin: 5px 0 0 0; font-size: 16px; font-weight: 600; color: #D32F2F;\">{{ $('Webhook Recepción').item.json.body.to }}</p>\n                    </td>\n                </tr>\n            </table>\n        </div>\n\n        <h3 style=\"color: #000000; border-bottom: 2px solid #EEEEEE; padding-bottom: 10px; margin-top: 40px; font-size: 20px;\">Escalas de Validez</h3>\n        \n        <div style=\"display: grid; grid-template-columns: repeat(3, 1fr); gap: 15px; margin-bottom: 30px;\">\n            <div style=\"background-color: #FFF4F4; padding: 15px; border-radius: 6px; border-left: 3px solid #D32F2F;\">\n                <p style=\"margin: 0 0 5px 0; font-size: 13px; font-weight: 700; color: #000000;\">L (Mentira)</p>\n                <p style=\"margin: 0; font-size: 12px; color: #444444; line-height: 1.5;\">{{ $('Parsear JSON Seguro').item.json.L_Mentira }}</p>\n            </div>\n            <div style=\"background-color: #FFF4F4; padding: 15px; border-radius: 6px; border-left: 3px solid #D32F2F;\">\n                <p style=\"margin: 0 0 5px 0; font-size: 13px; font-weight: 700; color: #000000;\">F (Incoherencia)</p>\n                <p style=\"margin: 0; font-size: 12px; color: #444444; line-height: 1.5;\">{{ $('Parsear JSON Seguro').item.json.F_Incoherencia }}</p>\n            </div>\n            <div style=\"background-color: #FFF4F4; padding: 15px; border-radius: 6px; border-left: 3px solid #D32F2F;\">\n                <p style=\"margin: 0 0 5px 0; font-size: 13px; font-weight: 700; color: #000000;\">K (Corrección)</p>\n                <p style=\"margin: 0; font-size: 12px; color: #444444; line-height: 1.5;\">{{ $('Parsear JSON Seguro').item.json.K_Correccion }}</p>\n            </div>\n        </div>\n\n        <h3 style=\"color: #000000; border-bottom: 2px solid #EEEEEE; padding-bottom: 10px; margin-top: 40px; font-size: 20px;\">Escalas Clínicas</h3>\n        \n        <div style=\"display: grid; grid-template-columns: 1fr 1fr; gap: 15px; margin-bottom: 30px;\">\n            <div style=\"background-color: #F8F9FA; padding: 12px; border-radius: 6px; border-left: 3px solid #333333;\">\n                <p style=\"margin: 0 0 5px 0; font-size: 13px; font-weight: 700; color: #000000;\">1 (Hs) Hipocondriasis</p>\n                <p style=\"margin: 0; font-size: 12px; color: #444444; line-height: 1.5;\">{{ $('Parsear JSON Seguro').item.json['1_Hs'] }}</p>\n            </div>\n            <div style=\"background-color: #F8F9FA; padding: 12px; border-radius: 6px; border-left: 3px solid #333333;\">\n                <p style=\"margin: 0 0 5px 0; font-size: 13px; font-weight: 700; color: #000000;\">2 (D) Depresión</p>\n                <p style=\"margin: 0; font-size: 12px; color: #444444; line-height: 1.5;\">{{ $('Parsear JSON Seguro').item.json['2_D'] }}</p>\n            </div>\n            <div style=\"background-color: #F8F9FA; padding: 12px; border-radius: 6px; border-left: 3px solid #333333;\">\n                <p style=\"margin: 0 0 5px 0; font-size: 13px; font-weight: 700; color: #000000;\">3 (Hy) Histeria</p>\n                <p style=\"margin: 0; font-size: 12px; color: #444444; line-height: 1.5;\">{{ $('Parsear JSON Seguro').item.json['3_Hy'] }}</p>\n            </div>\n            <div style=\"background-color: #F8F9FA; padding: 12px; border-radius: 6px; border-left: 3px solid #333333;\">\n                <p style=\"margin: 0 0 5px 0; font-size: 13px; font-weight: 700; color: #000000;\">4 (Pd) Desviación Psicopática</p>\n                <p style=\"margin: 0; font-size: 12px; color: #444444; line-height: 1.5;\">{{ $('Parsear JSON Seguro').item.json['4_Pd'] }}</p>\n            </div>\n            <div style=\"background-color: #F8F9FA; padding: 12px; border-radius: 6px; border-left: 3px solid #333333;\">\n                <p style=\"margin: 0 0 5px 0; font-size: 13px; font-weight: 700; color: #000000;\">5 (Mf) Masc./Feminidad</p>\n                <p style=\"margin: 0; font-size: 12px; color: #444444; line-height