    {
      "parameters": {
        "sendTo": "abelardo.carlos@hackesjobs.com.mx",
        "subject": "=Alerta Hacke's Jobs: Nuevo Test Moss Procesado [ Paciente: {{ $('Webhook Recepción').item.json.body.name }} Email: {{ $('Webhook Recepción').item.json.body.to }} ]",
        "message": "=<div style=\"font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; max-width: 700px; margin: 0 auto; border: 1px solid #E0E0E0; border-radius: 8px; overflow: hidden; box-shadow: 0 4px 15px rgba(0,0,0,0.08);\">\n    \n    <div style=\"background-color: #FF8C00; padding: 30px 20px; text-align: center; border-bottom: 4px solid #CC7000;\">\n        <h2 style=\"color: #FFFFFF; margin: 0; font-size: 26px; font-weight: 700; letter-spacing: 1px;\">Reporte Ejecutivo Moss</h2>\n        <p style=\"color: #FFF3E0; margin: 8px 0 0 0; font-size: 15px; font-weight: 500;\">Evaluación de Habilidades Gerenciales y Adaptabilidad Social</p>\n    </div>\n    \n    <div style=\"background-color: #FFFFFF; padding: 40px; color: #333333;\">\n        <p style=\"font-size: 16px; line-height: 1.6; margin-top: 0;\">Hola,</p>\n        <p style=\"font-size: 16px; line-height: 1.6;\">La IA ha completado el análisis profundo de la prueba psicométrica. El candidato ha recibido el enlace de pago correspondiente para liberar el proceso.</p>\n\n        \n        <div style=\"background-color: #F8F9FA; border-left: 5px solid #000000; padding: 20px; margin: 30px 0; border-radius: 0 4px 4px 0;\">\n            <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\">\n                <tr>\n                    <td width=\"50%\" style=\"padding-bottom: 15px;\">\n                        <p style=\"margin: 0; font-size: 12px; color: #888888; text-transform: uppercase; font-weight: 700; letter-spacing: 1px;\">Candidato Evaluado</p>\n                        <p style=\"margin: 5px 0 0 0; font-size: 18px; font-weight: 700; color: #000000;\">{{ $('Webhook Recepción').item.json.body.datos_paciente.nombre_completo }}</p>\n                    </td>\n                    <td width=\"50%\" style=\"padding-bottom: 15px;\">\n                        <p style=\"margin: 0; font-size: 12px; color: #888888; text-transform: uppercase; font-weight: 700; letter-spacing: 1px;\">Correo Electrónico</p>\n                        <p style=\"margin: 5px 0 0 0; font-size: 16px; font-weight: 600; color: #FF8C00;\">{{ $('Webhook Recepción').item.json.body.datos_paciente.email }}</p>\n                    </td>\n                </tr>\n            </table>\n        </div>\n\n        <h3 style=\"color: #000000; border-bottom: 2px solid #EEEEEE; padding-bottom: 10px; margin-top: 40px; font-size: 20px;\">Análisis de las 5 Dimensiones de Moss</h3>\n        \n        \n        <div style=\"margin-bottom: 25px;\">\n            <p style=\"margin: 0 0 8px 0; font-size: 15px; font-weight: 700; color: #000000;\">1. Habilidad de Supervisión <span style=\"color: #FF8C00;\">(Score: {{ $('Parsear JSON Seguro').item.json.Score_Supervision }}/100)</span></p>\n            <p style=\"margin: 0; font-size: 15px; color: #444444; background-color: #FFF8F0; padding: 15px; border-radius: 6px; line-height: 1.6; border-left: 3px solid #FF8C00;\">{{ $('Parsear JSON Seguro').item.json.Habilidad_Supervision }}</p>\n        </div>\n\n        \n        <div style=\"margin-bottom: 25px;\">\n            <p style=\"margin: 0 0 8px 0; font-size: 15px; font-weight: 700; color: #000000;\">2. Capacidad de Decisión en Relaciones Humanas <span style=\"color: #FF8C00;\">(Score: {{ $('Parsear JSON Seguro').item.json.Score_Decision }}/100)</span></p>\n            <p style=\"margin: 0; font-size: 15px; color: #444444; background-color: #FFF8F0; padding: 15px; border-radius: 6px; line-height: 1.6; border-left: 3px solid #FF8C00;\">{{ $('Parsear JSON Seguro').item.json.Capacidad_Decision }}</p>\n        </div>\n\n        \n        <div style=\"margin-bottom: 25px;\">\n            <p style=\"margin: 0 0 8px 0; font-size: 15px; font-weight: 700; color: #000000;\">3. Evaluación de Problemas Interpersonales <span style=\"color: #FF8C00;\">(Score: {{ $('Parsear JSON Seguro').item.json.Score_Evaluacion_Problemas }}/100)</span></p>\n            <p style=\"margin: 0; font-size: 15px; color: #444444; background-color: #FFF8F0; padding: 15px; border-radius: 6px; line-height: 1.6; border-left: 3px solid #FF8C00;\">{{ $('Parsear JSON Seguro').item.json.Evaluacion_Problemas }}</p>\n        </div>\n\n        \n        <div style=\"margin-bottom: 25px;\">\n            <p style=\"margin: 0 0 8px 0; font-size: 15px; font-weight: 700; color: #000000;\">4. Habilidad para Establecer Relaciones <span style=\"color: #FF8C00;\">(Score: {{ $('Parsear JSON Seguro').item.json.Score_Relaciones }}/100)</span></p>\n            <p style=\"margin: 0; font-size: 15px; color: #444444; background-color: #FFF8F0; padding: 15px; border-radius: 6px; line-height: 1.6; border-left: 3px solid #FF8C00;\">{{ $('Parsear JSON Seguro').item.json.Relaciones_Interpersonales }}</p>\n        </div>\n\n        \n        <div style=\"margin-bottom: 25px;\">\n            <p style=\"margin: 0 0 8px 0; font-size: 15px; font-weight: 700; color: #000000;\">5. Sentido Común y Tacto <span style=\"color: #FF8C00;\">(Score: {{ $('Parsear JSON Seguro').item.json.Score_Tacto }}/100)</span></p>\n            <p style=\"margin: 0; font-size: 15px; color: #444444; background-color: #FFF8F0; padding: 15px; border-radius: 6px; line-height: 1.6; border-left: 3px solid #FF8C00;\">{{ $('Parsear JSON Seguro').item.json.Sentido_Comun_y_Tacto }}</p>\n        </div>\n\n        \n        <h3 style=\"color: #000000; border-bottom: 2px solid #EEEEEE; padding-bottom: 10px; margin-top: 40px; font-size: 20px;\">Diagnóstico Ejecutivo</h3>\n        <div style=\"margin-bottom: 20px; display: flex; gap: 20px;\">\n            <div style=\"flex: 1; background-color: #F4FBF4; padding: 15px; border-radius: 6px; border: 1px solid #D1E8D1;\">\n                <p style=\"margin: 0 0 10px 0; font-size: 14px; font-weight: 700; color: #2E7D32;\">✓ Principales Fortalezas</p>\n                <p style=\"margin: 0; font-size: 14px; color: #444444; line-height: 1.5;\">{{ $('Parsear JSON Seguro').item.json.Fortalezas }}</p>\n            </div>\n            <div style=\"flex: 1; background-color: #FFF4F4; padding: 15px; border-radius: 6px; border: 1px solid #FFD1D1;\">\n                <p style=\"margin: 0 0 10px 0; font-size: 14px; font-weight: 700; color: #C62828;\">⚠ Áreas de Oportunidad</p>\n                <p style=\"margin: 0; font-size: 14px; color: #444444; line-height: 1.5;\">{{ $('Parsear JSON Seguro').item.json.Areas_Oportunidad }}</p>\n            </div>\n        </div>\n        \n        <div style=\"text-align: center; margin-top: 30px; padding: 20px; background-color: #FAFAFA; border-radius: 8px;\">\n            <p style=\"margin: 0; font-size: 14px; color: #666666; text-transform: uppercase; font-weight: 700;\">Índice de Compatibilidad Gerencial</p>\n            <p style=\"margin: 5px 0 0 0; font-size: 28px; font-weight: 800; color: #000000;\">{{ $('Parsear JSON Seguro').item.json.Compatibilidad_Gerencial }}%</p>\n        </div>\n\n    </div>\n    \n    \n    <div style=\"background-color: #000000; padding: 20px; text-align: center;\">\n        <p style=\"color: #FFFFFF; font-size: 12px; margin: 0; letter-spacing: 2px; font-weight: 600;\">HACKES JOBS TECHNOLOGIES</p>\n        <p style=\"color: #666666; font-size: 11px; margin: 5px 0 0 0;\">AI Recruitment & Assessment Core</p>\n    </div>\n</div>",
