        "message": "=<div style=\"font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; max-width: 750px; margin: 0 auto; border: 1px solid #E0E0E0; border-radius: 8px; overflow: hidden; box-shadow: 0 4px 15px rgba(0,0,0,0.08);\">\n    <div style=\"background-color: #FF8C00; padding: 30px 20px; text-align: center; border-bottom: 4px solid #CC7000;\">\n        <h2 style=\"color: #FFFFFF; margin: 0; font-size: 26px; font-weight: 700; letter-spacing: 1px;\">Reporte Ejecutivo Kostick</h2>\n        <p style=\"color: #FFF3E0; margin: 8px 0 0 0; font-size: 15px; font-weight: 500;\">Inventario de Percepción y Preferencias en el Entorno Laboral</p>\n    </div>\n    <div style=\"background-color: #FFFFFF; padding: 40px; color: #333333;\">\n        <p style=\"font-size: 16px; line-height: 1.6; margin-top: 0;\">Hola,</p>\n        <p style=\"font-size: 16px; line-height: 1.6;\">La IA ha completado el análisis profundo de la prueba psicométrica Kostick. El candidato ha recibido el enlace de pago correspondiente para liberar el proceso.</p>\n\n        <div style=\"background-color: #F8F9FA; border-left: 5px solid #000000; padding: 20px; margin: 30px 0; border-radius: 0 4px 4px 0;\">\n            <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\">\n                <tr>\n                    <td width=\"50%\" style=\"padding-bottom: 15px;\">\n                        <p style=\"margin: 0; font-size: 12px; color: #888888; text-transform: uppercase; font-weight: 700; letter-spacing: 1px;\">Candidato Evaluado</p>\n                        <p style=\"margin: 5px 0 0 0; font-size: 18px; font-weight: 700; color: #000000;\">{{ $('Webhook Recepción').item.json.body.datos_paciente.nombre_completo }}</p>\n                    </td>\n                    <td width=\"50%\" style=\"padding-bottom: 15px;\">\n                        <p style=\"margin: 0; font-size: 12px; color: #888888; text-transform: uppercase; font-weight: 700; letter-spacing: 1px;\">Correo Electrónico</p>