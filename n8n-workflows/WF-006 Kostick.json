      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// 1. Extracción profunda y específica para Gemini 3.1 Flash Lite\nlet rawData = $input.item.json;\nlet textToParse = \"\";\n\n// Buscamos la ruta exacta donde Gemini 3.1 esconde el texto\nif (rawData.content && rawData.content.parts && rawData.content.parts[0] && rawData.content.parts[0].text) {\n    textToParse = rawData.content.parts[0].text;\n} else if (rawData.message && rawData.message.content) {\n    textToParse = rawData.message.content;\n} else if (rawData.text) {\n    textToParse = rawData.text;\n} else {\n    textToParse = JSON.stringify(rawData);\n}\n\n// 2. Forzar conversión a String\ntextToParse = String(textToParse);\n\n// 3. Extracción Blindada con Regex\nconst match = textToParse.match(/\\{[\\s\\S]*\\}/);\nlet extractedJson = match ? match[0] : textToParse;\n\n// 4. Parseo y salida\ntry {\n    const parsedData = JSON.parse(extractedJson);\n    return { json: parsedData };\n} catch (error) {\n    return {\n        json: {\n            \"Grado_Energia\": \"Error de Parseo\",\n            \"Liderazgo\": \"Error de Parseo\",\n            \"Modo_Vida\": \"Error de Parseo\",\n            \"Naturaleza_Social\": \"Error de Parseo\",\n            \"Adaptacion_Trabajo\": \"Error de Parseo\",\n            \"Naturaleza_Emocional\": \"Error de Parseo\",\n            \"Subordinacion\": \"Error de Parseo\",\n            \"Fortalezas\": \"Error de Parseo\",\n            \"Areas_Oportunidad\": \"Error de Parseo\",\n            \"Indice_Compatibilidad_Rol\": 0\n        }\n    };\n}"
      },
