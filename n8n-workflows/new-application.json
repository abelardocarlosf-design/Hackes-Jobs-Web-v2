{
  "name": "Hackes Jobs - New Application Workflow",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "new-application",
        "options": {}
      },
      "name": "Webhook: Nueva Aplicacion",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [250, 300],
      "webhookId": "hackesjobs-new-application"
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.body.data.scoreBreakdown.tier }}",
              "operation": "in",
              "value2": "S,A"
            }
          ]
        }
      },
      "name": "Es Tier S o A?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [450, 300]
    },
    {
      "parameters": {
        "fromEmail": "abelardo.carlos@hackesjobs.com.mx",
        "toEmail": "abelardo.carlos@hackesjobs.com.mx",
        "subject": "=⭐ Candidato Tier {{ $json.body.data.scoreBreakdown.tier }} para {{ $json.body.data.jobTitle }}",
        "html": "=<h2>Un candidato de alto perfil ha aplicado!</h2><br><ul><li><b>Candidato:</b> {{ $json.body.data.candidateName }} ({{ $json.body.data.candidateEmail }})</li><li><b>Vacante:</b> {{ $json.body.data.jobTitle }} ({{ $json.body.data.company }})</li><li><b>Score Total:</b> {{ $json.body.data.score }} / 100</li><li><b>Tier:</b> {{ $json.body.data.scoreBreakdown.tier }}</li></ul><br><h3>Desglose:</h3><ul><li>Experiencia: {{ $json.body.data.scoreBreakdown.experience }}</li><li>Skills: {{ $json.body.data.scoreBreakdown.skills }}</li><li>Educación: {{ $json.body.data.scoreBreakdown.education }}</li><li>Psicométrico: {{ $json.body.data.scoreBreakdown.psychometric }}</li></ul>",
        "options": {}
      },
      "name": "Email (Tier Alto)",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2,
      "position": [700, 200]
    },
    {
      "parameters": {
        "fromEmail": "abelardo.carlos@hackesjobs.com.mx",
        "toEmail": "abelardo.carlos@hackesjobs.com.mx",
        "subject": "=📋 Nueva Aplicación para {{ $json.body.data.jobTitle }}",
        "html": "=<h2>Un candidato ha aplicado.</h2><br><ul><li><b>Candidato:</b> {{ $json.body.data.candidateName }} ({{ $json.body.data.candidateEmail }})</li><li><b>Vacante:</b> {{ $json.body.data.jobTitle }}</li><li><b>Tier:</b> {{ $json.body.data.scoreBreakdown.tier }}</li></ul>",
        "options": {}
      },
      "name": "Email (Normal)",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2,
      "position": [700, 400]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.whatsapp.com/v1/messages", 
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "messaging_product",
              "value": "whatsapp"
            },
            {
              "name": "to",
              "value": "525650405218"
            },
            {
              "name": "type",
              "value": "text"
            },
            {
              "name": "text",
              "value": "={ \"body\": \"⭐ *TOP CANDIDATO*\\n\\n{{ $json.body.data.candidateName }} aplicó a *{{ $json.body.data.jobTitle }}*\\n\\nTier: {{ $json.body.data.scoreBreakdown.tier }}\\nScore: {{ $json.body.data.score }}/100\" }"
            }
          ]
        },
        "options": {}
      },
      "name": "Notificar WA (Tier Alto)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [950, 200]
    }
  ],
  "connections": {
    "Webhook: Nueva Aplicacion": {
      "main": [
        [
          {
            "node": "Es Tier S o A?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Es Tier S o A?": {
      "main": [
        [
          {
            "node": "Email (Tier Alto)",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Email (Normal)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Email (Tier Alto)": {
      "main": [
        [
          {
            "node": "Notificar WA (Tier Alto)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {}
}
