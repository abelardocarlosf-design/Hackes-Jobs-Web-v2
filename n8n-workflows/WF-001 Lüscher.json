    {
      "parameters": {
        "sendTo": "abelardo.carlos@hackesjobs.com.mx",
        "subject": "=Alerta Hackes Jobs Technologies: Nuevo Reporte Lüscher Procesado [ {{ $('Webhook Recepción').item.json.body.datos_paciente.nombre_completo }} | {{ $('Webhook Recepción').item.json.body.datos_paciente.email }} ]",
        "message": "=<div style=\"font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; max-width: 650px; margin: 0 auto; border: 1px solid #E0E0E0; border-radius: 8px; overflow: hidden; box-shadow: 0 4px 6px rgba(0,0,0,0.05);\">\n    \n    <div style=\"background-color: #FF8C00; padding: 25px 20px; text-align: center;\">\n        <h2 style=\"color: #FFFFFF; margin: 0; font-size: 24px; font-weight: 600; letter-spacing: 0.5px;\">Reporte Psicométrico Completado</h2>\n        <p style=\"color: #FFF3E0; margin: 5px 0 0 0; font-size: 14px;\">Test de Colores de Lüscher</p>\n    </div>\n\n    <div style=\"background-color: #FFFFFF; padding: 30px; color: #333333;\">\n        <p style=\"font-size: 16px; line-height: 1.6; margin-top: 0;\">Hola,</p>\n        <p style=\"font-size: 16px; line-height: 1.6;\">El sistema ha procesado exitosamente una nueva evaluación. A continuación, se presenta el análisis clínico y laboral generado por IA:</p>\n\n        <div style=\"background-color: #F8F9FA; border-left: 4px solid #333333; padding: 15px 20px; margin: 25px 0;\">\n            <p style=\"margin: 0; font-size: 14px; color: #666666; text-transform: uppercase; font-weight: 700; letter-spacing: 1px;\">Datos del Candidato</p>\n            <p style=\"margin: 5px 0 0 0; font-size: 16px; font-weight: 600; color: #000000;\">{{ $('Webhook Recepción').item.json.body.datos_paciente.nombre_completo }}</p>\n            \n            <p style=\"margin: 15px 0 0 0; font-size: 14px; color: #666666; text-transform: uppercase; font-weight: 700; letter-spacing: 1px;\">Contacto</p>\n            <p style=\"margin: 5px 0 0 0; font-size: 16px; font-weight: 600; color: #FF8C00;\">\n                <a href=\"mailto:{{ $('Webhook Recepción').item.json.body.datos_paciente.email }}\" style=\"color: #FF8C00; text-decoration: none;\">{{ $('Webhook Recepción').item.json.body.datos_paciente.email }}</a>\n            </p>\n        </div>\n\n        <h3 style=\"color: #000000; border-bottom: 2px solid #EEEEEE; padding-bottom: 8px; margin-top: 30px; font-size: 18px;\">Análisis de Resultados Lüscher</h3>\n        \n        <div style=\"margin-bottom: 20px;\">\n            <p style=\"margin: 0 0 5px 0; font-size: 14px; font-weight: 700; color: #FF8C00;\">Secuencia de Colores:</p>\n            <p style=\"margin: 0; font-size: 15px; line-height: 1.5; color: #444444; background-color: #FFF8F0; padding: 10px; border-radius: 4px;\">{{ $('Parsear JSON Seguro').item.json.secuencia_colores }}</p>\n        </div>\n\n        <div style=\"margin-bottom: 20px;\">\n            <p style=\"margin: 0 0 5px 0; font-size: 14px; font-weight: 700; color: #FF8C00;\">Estado Psicofísico:</p>\n            <p style=\"margin: 0; font-size: 15px; line-height: 1.5; color: #444444; background-color: #FFF8F0; padding: 10px; border-radius: 4px;\">{{ $('Parsear JSON Seguro').item.json.estado_psicofisico }}</p>\n        </div>\n\n        <div style=\"margin-bottom: 20px;\">\n            <p style=\"margin: 0 0 5px 0; font-size: 14px; font-weight: 700; color: #FF8C00;\">Objetivos y Deseos:</p>\n            <p style=\"margin: 0; font-size: 15px; line-height: 1.5; color: #444444; background-color: #FFF8F0; padding: 10px; border-radius: 4px;\">{{ $('Parsear JSON Seguro').item.json.objetivos_y_deseos }}</p>\n        </div>\n\n        <div style=\"margin-bottom: 20px;\">\n            <p style=\"margin: 0 0 5px 0; font-size: 14px; font-weight: 700; color: #FF8C00;\">Fuentes de Estrés:</p>\n            <p style=\"margin: 0; font-size: 15px; line-height: 1.5; color: #444444; background-color: #FFF8F0; padding: 10px; border-radius: 4px;\">{{ $('Parsear JSON Seguro').item.json.fuentes_de_estres }}</p>\n        </div>\n\n        <div style=\"margin-bottom: 20px;\">\n            <p style=\"margin: 0 0 5px 0; font-size: 14px; font-weight: 700; color: #FF8C00;\">Perfil Laboral (Encaje Organizacional):</p>\n            <p style=\"margin: 0; font-size: 15px; line-height: 1.5; color: #444444; background-color: #FFF8F0; padding: 10px; border-radius: 4px;\">{{ $('Parsear JSON Seguro').item.json.perfil_laboral }}</p>\n        </div>\n\n        <p style=\"font-size: 14px; color: #888888; font-style: italic; margin-top: 30px; text-align: center;\">\n            * Los datos de esta evaluación han sido respaldados automáticamente en Google Sheets.\n        </p>\n    </div>\n\n    <div style=\"background-color: #1A1A1A; padding: 15px; text-align: center;\">\n        <p style=\"color: #FFFFFF; font-size: 12px; margin: 0; letter-spacing: 1px;\">HACKE'S JOBS RECRUITMENT SYSTEM</p>\n    </div>\n</div>",
